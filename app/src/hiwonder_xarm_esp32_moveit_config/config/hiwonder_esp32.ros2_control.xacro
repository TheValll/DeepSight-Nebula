<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="hiwonder_esp32_ros2_control"
    params="name initial_positions_file use_mock_hardware serial_port gripper_hardware_io_enabled:=true read_only:=false">
    <xacro:property
      name="initial_positions"
      value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
    <xacro:property name="radians_per_raw" value="${4.1887902047863905 / 1000.0}"/>
    <!-- Joint scales and zero references identified on 2026-11-02 by an arm
         self-calibration: 23 arm poses looking at a checkerboard lying on the desk
         (camera mount, shoulder/elbow zeros and all scales; leave-one-out error
         5.7 px instead of 20.3 px), plus the wrist zero from a ball held in the
         gripper. Replaces the per-joint checkerboard scales of 2026-10-16. -->
    <xacro:property name="base_radians_per_raw" value="${radians_per_raw * 0.9477}"/>
    <xacro:property name="shoulder_radians_per_raw" value="${radians_per_raw * 0.9938}"/>
    <xacro:property name="elbow_radians_per_raw" value="${radians_per_raw * 1.0318}"/>
    <xacro:property name="wrist_radians_per_raw" value="${radians_per_raw * 0.9722}"/>
    <xacro:property name="gripper_units_per_raw" value="${0.03 / 556.0}"/>

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>hiwonder_xarm_esp32_hardware/HiwonderSystem</plugin>
          <param name="port">${serial_port}</param>
          <param name="baudrate">115200</param>
          <param name="timeout_ms">50</param>
          <!-- CH340 DTR/RTS can reset the ESP32 when the serial port opens. -->
          <param name="startup_delay_ms">2000</param>
          <param name="movement_duration_ms">40</param>
          <!-- A lost servo reply keeps the last position for up to 5 cycles. -->
          <param name="max_consecutive_read_failures">5</param>
          <!-- read_only suppresses every hardware output in HiwonderSystem. -->
          <param name="read_only">${read_only}</param>
        </xacro:unless>
      </hardware>

      <!-- Raw ranges include a 20-unit margin from the measured positions. The plugin
           clamps commands to them. The min and max below extend them by 5 raw units so
           a servo settling just past its commanded limit does not stop the controllers;
           MoveIt plans 10 units inside them (joint_limits.yaml). -->
      <joint name="limb1_to_base_link_joint">
        <param name="servo_id">6</param>
        <param name="raw_reference">501</param>
        <param name="ros_reference">0.015082</param>
        <param name="units_per_raw">${base_radians_per_raw}</param>
        <param name="direction">1</param>
        <param name="raw_min">20</param>
        <param name="raw_max">980</param>
        <param name="hardware_io_enabled">true</param>
        <command_interface name="position">
          <param name="min">-1.914142</param>
          <param name="max">1.936367</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['limb1_to_base_link_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="limb2_to_limb1_joint">
        <param name="servo_id">5</param>
        <param name="raw_reference">856</param>
        <param name="ros_reference">1.389281</param>
        <param name="units_per_raw">${shoulder_radians_per_raw}</param>
        <param name="direction">1</param>
        <param name="raw_min">119</param>
        <param name="raw_max">849</param>
        <param name="hardware_io_enabled">true</param>
        <command_interface name="position">
          <param name="min">-1.699431</param>
          <param name="max">1.380956</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['limb2_to_limb1_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="limb3_to_limb2_joint">
        <param name="servo_id">4</param>
        <param name="raw_reference">863</param>
        <param name="ros_reference">1.515678</param>
        <param name="units_per_raw">${elbow_radians_per_raw}</param>
        <param name="direction">1</param>
        <param name="raw_min">20</param>
        <param name="raw_max">980</param>
        <param name="hardware_io_enabled">true</param>
        <command_interface name="position">
          <param name="min">-2.094000</param>
          <param name="max">2.042937</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['limb3_to_limb2_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="limb4_to_limb3_joint">
        <param name="servo_id">3</param>
        <param name="raw_reference">503</param>
        <param name="ros_reference">-0.036851</param>
        <param name="units_per_raw">${wrist_radians_per_raw}</param>
        <param name="direction">1</param>
        <param name="raw_min">61</param>
        <param name="raw_max">858</param>
        <param name="hardware_io_enabled">true</param>
        <command_interface name="position">
          <param name="min">-1.857265</param>
          <param name="max">1.429254</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['limb4_to_limb3_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="limb5_to_limb4_joint">
        <param name="servo_id">2</param>
        <param name="raw_reference">512</param>
        <param name="ros_reference">-0.008483</param>
        <param name="units_per_raw">${radians_per_raw}</param>
        <param name="direction">1</param>
        <param name="raw_min">141</param>
        <param name="raw_max">840</param>
        <param name="hardware_io_enabled">true</param>
        <command_interface name="position">
          <param name="min">-1.583468</param>
          <param name="max">1.386384</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['limb5_to_limb4_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="gripper_left_joint">
        <param name="servo_id">1</param>
        <param name="raw_reference">528</param>
        <param name="ros_reference">0.0</param>
        <param name="units_per_raw">${gripper_units_per_raw}</param>
        <param name="direction">-1</param>
        <param name="raw_min">270</param>
        <param name="raw_max">786</param>
        <param name="movement_duration_ms">1000</param>
        <!-- Closing duration is independent of opening and arm movements: fast
             enough that the ball has no time to slide away, without slamming it. -->
        <param name="closing_movement_duration_ms">250</param>
        <param name="hardware_io_enabled">${gripper_hardware_io_enabled}</param>
        <command_interface name="position">
          <param name="min">-0.013921</param>
          <param name="max">0.013921</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['gripper_left_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="gripper_right_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
