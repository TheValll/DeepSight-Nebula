<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hiwonder_esp32">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import hiwonder_esp32 urdf file -->
    <xacro:include filename="$(find hiwonder_xarm_esp32_description)/urdf/hiwonder_esp32.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="hiwonder_esp32.ros2_control.xacro" />


    <xacro:hiwonder_esp32_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
