  <link name="gripper_right_link">
    <inertial>
      <origin xyz="0.007435 -0.006142 0.028025" rpy="0.0 0.0 0.0"/>
      <mass value="0.030835"/>
      <inertia ixx="1.068694e-05" iyy="1.120908e-05" izz="7.564734e-07" ixy="-2.298441e-08" iyz="-9.006570e-08" ixz="-1.959376e-06"/>
