<?xml version="1.0" ?>
<robot name="hiwonder_esp32" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="common_properties.xacro"/>
  <xacro:include filename="hiwonder_esp32_arm.xacro"/>
  <xacro:include filename="hiwonder_esp32_gripper.xacro"/>
  <xacro:include filename="hiwonder_esp32_camera.xacro"/>

  <!-- ==================== GAZEBO ==================== -->

  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
  </gazebo>

</robot>
