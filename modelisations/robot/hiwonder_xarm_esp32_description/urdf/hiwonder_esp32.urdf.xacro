    <parent link="limb4_link"/>
    <child link="limb5_link"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="-1.571" upper="1.571" effort="25" velocity="2.6"/>
  </joint>

  <!-- ==================== GRIPPER (prismatic simplification) ==================== -->

  <!-- Gears, fixed visual elements -->
  <link name="gear_left_link">
    <inertial>
      <origin xyz="0.003525 0.007478 0.005017" rpy="0.0 0.0 0.0"/>
      <mass value="0.018832"/>
      <inertia ixx="1.988236e-06" iyy="3.502159e-06" izz="1.586593e-06" ixy="2.627571e-08" iyz="2.803909e-08" ixz="-1.137093e-06"/>
