<?xml version="1.0" ?>
<robot name="hiwonder_esp32" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="common_properties.xacro"/>

  <!-- ==================== BASE ==================== -->

  <link name="base_link">
    <inertial>
      <origin xyz="-0.000251 0.036738 0.019525" rpy="0.0 0.0 0.0"/>
      <mass value="1.020079"/>
      <inertia ixx="5.790970e-03" iyy="1.673311e-03" izz="6.837773e-03" ixy="-8.404032e-06" iyz="5.366810e-04" ixz="5.531248e-06"/>
