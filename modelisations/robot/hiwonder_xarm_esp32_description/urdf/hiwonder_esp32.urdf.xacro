      <origin xyz="0.020638 -0.033182 -0.008675" rpy="0.0 0.0 0.0"/>
      <mass value="0.258047"/>
      <inertia ixx="9.125036e-05" iyy="7.224678e-05" izz="7.967461e-05" ixy="1.361791e-06" iyz="-8.812793e-06" ixz="3.288307e-07"/>
