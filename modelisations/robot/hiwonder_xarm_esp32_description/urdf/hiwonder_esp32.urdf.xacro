      <origin xyz="-0.003527 0.001779 0.005405" rpy="0.0 0.0 0.0"/>
      <mass value="0.017925"/>
      <inertia ixx="2.161682e-06" iyy="3.500032e-06" izz="1.794333e-06" ixy="6.190968e-08" iyz="-3.424248e-08" ixz="1.134985e-06"/>
