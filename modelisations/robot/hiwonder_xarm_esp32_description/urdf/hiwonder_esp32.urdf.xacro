    <parent link="limb5_link"/>
    <child link="gear_right_link"/>
  </joint>

  <!-- Left finger, ACTIVE prismatic -->
  <link name="gripper_left_link">
    <inertial>
      <origin xyz="-0.007413 -0.006037 0.028054" rpy="0.0 0.0 0.0"/>
      <mass value="0.030837"/>
      <inertia ixx="1.070256e-05" iyy="1.120889e-05" izz="7.420144e-07" ixy="2.927785e-08" iyz="-1.153532e-07" ixz="1.921105e-06"/>
