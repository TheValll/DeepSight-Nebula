    <child link="limb4_link"/>
    <axis xyz="-1.0 0.0012 0.0002"/>
    <limit lower="-2.094" upper="2.094" effort="17" velocity="2.7"/>
  </joint>

  <!-- ==================== WRIST (limb5 = gripper base) ==================== -->

  <link name="limb5_link">
    <inertial>
      <origin xyz="0.013215 -0.028007 -0.008817" rpy="0.0 0.0 0.0"/>
      <mass value="0.212537"/>
      <inertia ixx="5.821128e-05" iyy="8.006153e-05" izz="6.587425e-05" ixy="6.329734e-06" iyz="-4.389587e-06" ixz="1.093490e-06"/>
