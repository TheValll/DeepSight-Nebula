    <child link="limb2_link"/>
    <axis xyz="-1.0 -0.0017 0.0004"/>
    <limit lower="-2.094" upper="2.094" effort="17" velocity="2.7"/>
  </joint>

  <link name="limb3_link">
    <inertial>
      <origin xyz="0.017608 -0.025096 0.029125" rpy="0.0 0.0 0.0"/>
      <mass value="0.449449"/>
      <inertia ixx="6.118410e-04" iyy="3.338003e-04" izz="3.278646e-04" ixy="5.996446e-07" iyz="2.867923e-04" ixz="-6.464974e-07"/>
