    <visual>
      <origin xyz="0.025163 -0.012803 -0.205803" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://hiwonder_xarm_esp32_description/meshes/limb4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Steel"/>
