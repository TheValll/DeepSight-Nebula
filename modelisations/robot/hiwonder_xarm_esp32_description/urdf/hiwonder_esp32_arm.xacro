  </link>

  <joint name="limb1_to_base_link_joint" type="revolute">
    <origin xyz="-0.000088 0.002467 0.037808" rpy="0.0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="limb1_link"/>
    <axis xyz="0.0 0.0 -1.0"/>
    <limit lower="-2.793" upper="2.793" effort="10" velocity="2.0"/>
  </joint>

  <link name="limb2_link">
    <inertial>
      <origin xyz="-0.022655 0.034807 0.038534" rpy="0.0 0.0 0.0"/>
      <mass value="0.219799"/>
      <inertia ixx="2.325983e-04" iyy="1.959224e-04" izz="1.748409e-04" ixy="5.157288e-07" iyz="-1.040993e-04" ixz="5.750093e-07"/>
    </inertial>
    <visual>
      <origin xyz="-0.023557 -0.003681 -0.068592" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://hiwonder_xarm_esp32_description/meshes/limb2.stl" scale="0.001 0.001 0.001"/>
