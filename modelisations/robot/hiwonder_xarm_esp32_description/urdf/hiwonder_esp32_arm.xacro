  <joint name="limb5_to_limb4_joint" type="revolute">
    <origin xyz="0.020801 -0.052531 0.0" rpy="-0.001296 1.134464 -0.000736"/>
    <parent link="limb4_link"/>
    <child link="limb5_link"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit lower="-1.571" upper="1.571" effort="25" velocity="2.6"/>
  </joint>

</robot>
