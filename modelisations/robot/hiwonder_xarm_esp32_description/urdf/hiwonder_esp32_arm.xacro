  <joint name="limb3_to_limb2_joint" type="revolute">
    <origin xyz="-0.043849 0.067400 0.074553" rpy="-1.518436 0.0 0.0"/>
    <parent link="limb2_link"/>
    <child link="limb3_link"/>
    <axis xyz="1.0 -0.001 0.0007"/>
    <limit lower="-2.094" upper="2.094" effort="17" velocity="2.7"/>
  </joint>

  <link name="limb4_link">
    <inertial>
      <origin xyz="0.020638 -0.033182 -0.008675" rpy="0.0 0.0 0.0"/>
      <mass value="0.258047"/>
      <inertia ixx="9.125036e-05" iyy="7.224678e-05" izz="7.967461e-05" ixy="1.361791e-06" iyz="-8.812793e-06" ixz="3.288307e-07"/>
